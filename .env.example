NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPECTED_SUPABASE_PROJECT_REF=your-project-ref
PRODUCTION_SUPABASE_PROJECT_REF=your-production-project-ref
DEPLOYMENT_ENVIRONMENT=local

# Keep disabled until AI Gateway eligibility and Auto-reload OFF are verified.
# Vercel deployments authenticate with VERCEL_OIDC_TOKEN automatically.
# Local testing may use AI_GATEWAY_API_KEY in an uncommitted .env.local.
AI_TEXT_ENABLED=false
AI_FREE_ONLY_VERIFIED=false

